# ==========================================
# HELIOS EXTRACTION PIPELINE - ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# Your Gemini API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-api-key-here

# Email address for SEC EDGAR API (required for rate limiting compliance)
MY_EMAIL=your@email.com

# Company name used in SEC EDGAR API requests
MY_COMPANY_NAME=your-company-name

# Default ticker for testing
TESTING_TICKER=GOOGL

# Gemini model to use for extraction
EXTRACTOR_MODEL = "gemini-2.5-flash-lite" 
REASONING_MODEL = "gemini-2.5-flash-lite" 

# Maximum number of parallel LLM API calls
MAX_LLM_PARALLEL_CALLS=10

# How many years back to fetch for each filing type
YEARS_BACK_10K=1
YEARS_BACK_10Q=1
YEARS_BACK_8K=1  
YEARS_BACK_DEF14A=1 
YEARS_BACK_FORM4=1
