# ==========================================
# HELIOS PIPELINE — ENVIRONMENT CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
#
# ALL values below are REQUIRED — the pipeline will fail fast
# with a clear error if any are missing.
#
# For engineering constants (retry tuning, temperature, rate limits),
# see helios/config.py — those rarely change and live in Python only.

# ------------------------------------------
# SECRETS
# ------------------------------------------
GEMINI_API_KEY=your-api-key-here

# ------------------------------------------
# SEC EDGAR IDENTITY (required for API compliance)
# ------------------------------------------
MY_COMPANY_NAME=your-company-name
MY_EMAIL=your@email.com

# ------------------------------------------
# MODEL SELECTION
# ------------------------------------------
EDGAR_EXTRACTOR_MODEL=gemini-2.5-flash-lite
EARNINGS_CALL_ANALYZER_MODEL=gemini-2.5-flash-lite
MARKET_ANALYSIS_MODEL=gemini-2.5-flash-lite
SECTOR_ANALYSIS_MODEL=gemini-2.5-flash-lite
EXTERNAL_REALITY_CHECK_MODEL=gemini-2.5-flash-lite
NARRATIVE_VALIDATOR_MODEL=gemini-2.5-flash-lite
QUANTITATIVE_BASELINE_MODEL=gemini-2.5-flash-lite
STOCK_VALUATION_MODEL=gemini-2.5-flash-lite
BUSINESS_OVERVIEW_MODEL=gemini-2.5-flash-lite

# ------------------------------------------
# CONCURRENCY
# ------------------------------------------
GEMINI_MAX_PARALLEL_CALLS=3

# ------------------------------------------
# DATA DEPTH (how many years back to fetch)
# ------------------------------------------
YEARS_BACK_10K=1
YEARS_BACK_10Q=1
YEARS_BACK_8K=1
YEARS_BACK_DEF14A=1
YEARS_BACK_FORM4=1
YEARS_BACK_EARNINGS_CALLS=3

# ------------------------------------------
# CLI DEFAULTS (only one with a Python fallback)
# ------------------------------------------
TESTING_TICKER=GOOGL
